    "fn": "deepl_target",
    "input": "en-US",
    "expected": "EN-US"
  },
  {
    "name": "deepl target keeps explicit GB",
    "fn": "deepl_target",
    "input": "en-gb",
    "expected": "EN-GB"
  },
  {
    "name": "deepl target defaults Portuguese to European",
    "fn": "deepl_target",
    "input": "pt",
    "expected": "PT-PT"
  },
  {
    "name": "deepl target keeps Brazilian",
    "fn": "deepl_target",
    "input": "pt-BR",
    "expected": "PT-BR"
  },
  {
    "name": "deepl target maps Chinese to Hans",
    "fn": "deepl_target",
    "input": "zh",
    "expected": "ZH-HANS"
  },
  {
