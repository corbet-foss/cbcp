{
  "name": "@corbet-labs/cbcp",
  "version": "0.1.2",
  "description": "Deterministic BCP 47 locale-ID casting and vendor code mapping. No models, no I/O: same input always yields the same output. Mirrors the cbcp Rust crate release line.",
  "license": "LGPL-3.0-only WITH LGPL-3.0-linking-exception",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbet-foss/cbcp.git",
    "directory": "js/@corbet-labs/cbcp"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSES/**/*"
  ],
  "scripts": {
    "prepack": "bun run build",
    "build": "bun ./scripts/build.mjs",
    "conformance": "bun test",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "bun-types": "^1.4.2",
    "typescript": "6.0.3"
  },
  "module": "./dist/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/corbet-foss/cbcp#readme",
  "bugs": {
    "url": "https://github.com/corbet-foss/cbcp/issues"
  },
  "keywords": [
    "i18n",
    "locale",
    "bcp47",
    "typescript",
    "rust",
    "cbcp"
  ]
}
